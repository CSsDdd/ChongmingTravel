page {
  min-height: 100%;
  background: #f5f7f4;
}

.comment-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 160rpx;
  box-sizing: border-box;
}

.target-bar {
  position: sticky;
  top: 0;
  z-index: 2;
  padding-bottom: 20rpx;
  background: #f5f7f4;
}

.target-loading {
  display: flex;
  min-height: 190rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #929a94;
  background: #ffffff;
  font-size: 25rpx;
}

.comment-section {
  min-height: 360rpx;
}

.comment-list {
  padding: 0 8rpx;
}

.comment-state {
  display: flex;
  min-height: 360rpx;
  align-items: center;
  justify-content: center;
  color: #929a94;
  font-size: 25rpx;
}

.page-placeholder {
  display: flex;
  min-height: 480rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  text-align: center;
}

.placeholder-title {
  color: #334139;
  font-size: 30rpx;
  font-weight: 600;
}

.placeholder-description {
  color: #929a94;
  font-size: 25rpx;
}

.comment-input-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 3;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e1e7e1;
  background: rgba(255, 255, 255, 0.96);
}

.comment-input-dock-expanded {
  animation: comment-composer-slide-up 180ms ease-out;
}

.comment-input-entry {
  display: flex;
  height: 72rpx;
  align-items: center;
  padding: 0 28rpx;
  border-radius: 36rpx;
  background: #f0f3ef;
}

.comment-input-entry-hover {
  background: #e5ebe5;
}

.comment-input-placeholder {
  color: #8b938d;
  font-size: 27rpx;
}

.comment-composer {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f0f3ef;
}

.reply-context {
  margin-bottom: 12rpx;
  color: #66806e;
  font-size: 24rpx;
  line-height: 34rpx;
}

.comment-textarea {
  width: 100%;
  height: 180rpx;
  padding: 4rpx 6rpx;
  color: #26352c;
  background: transparent;
  font-size: 28rpx;
  line-height: 42rpx;
  box-sizing: border-box;
}

.comment-composer-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 0 6rpx;
}

.comment-cancel-action,
.comment-send-action {
  min-width: 96rpx;
  padding: 10rpx 18rpx;
  border-radius: 26rpx;
  font-size: 26rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.comment-cancel-action {
  color: #858d87;
}

.comment-send-action {
  color: #aab4ad;
  background: #e3e8e3;
}

.comment-send-action-active {
  color: #ffffff;
  background: #2f6f4e;
}

.comment-footer-action-hover {
  opacity: 0.65;
}

@keyframes comment-composer-slide-up {
  from {
    opacity: 0;
    transform: translateY(32rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.report-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 5;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 31, 27, 0.36);
}

.report-sheet {
  width: 100%;
  padding: 34rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  animation: comment-composer-slide-up 180ms ease-out;
}

.report-title {
  display: block;
  color: #27352c;
  font-size: 31rpx;
  font-weight: 600;
}

.report-description {
  display: block;
  margin-top: 8rpx;
  color: #929a94;
  font-size: 23rpx;
}

.report-reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.report-reason {
  padding: 12rpx 20rpx;
  border: 1rpx solid #dce4dd;
  border-radius: 28rpx;
  color: #68746c;
  background: #f7f8f6;
  font-size: 24rpx;
  line-height: 32rpx;
}

.report-reason-selected {
  border-color: #7da18a;
  color: #2f6f4e;
  background: #eaf2ec;
}

.report-detail {
  width: 100%;
  height: 150rpx;
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #344139;
  background: #f2f4f1;
  font-size: 25rpx;
  line-height: 38rpx;
  box-sizing: border-box;
}

.report-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.report-cancel,
.report-submit {
  min-width: 130rpx;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 25rpx;
  line-height: 34rpx;
  text-align: center;
  box-sizing: border-box;
}

.report-cancel {
  color: #858d87;
}

.report-submit {
  color: #aab4ad;
  background: #e3e8e3;
}

.report-submit-active {
  color: #ffffff;
  background: #2f6f4e;
}
