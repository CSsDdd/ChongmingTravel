.detail-page {
  height: 100vh;
}

.hero-image,
.hero-placeholder {
  height: 420rpx;
  width: 100%;
}

.hero-image {
  display: block;
}

.hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.9);
  font-size: 30rpx;
  background: linear-gradient(145deg, #567c60, #b0c79f);
}

.detail-content {
  display: flex;
  flex-direction: column;
  padding: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
}

.location {
  margin-top: 20rpx;
  color: #2f6f4e;
  font-size: 28rpx;
  font-weight: 600;
}

.tags {
  margin-top: 12rpx;
  color: #737a74;
  font-size: 25rpx;
}

.divider {
  height: 2rpx;
  margin: 36rpx 0;
  background: #e2e7e2;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.description {
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.7;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 48rpx;
}

.actions button {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
}

.secondary-action {
  color: #2f6f4e;
  background: #ffffff;
  border: 2rpx solid #2f6f4e;
}

.primary-action {
  color: #ffffff;
  background: #2f6f4e;
}

.state-message {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #737a74;
  font-size: 28rpx;
}
