page {
  height: 100%;
  overflow: hidden;
}

.favorites-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.favorites-header {
  flex-shrink: 0;
  padding: 20rpx 24rpx 22rpx;
}

.search-entry {
  height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: 38rpx;
  color: #737a74;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(42, 65, 49, 0.06);
}

.search-icon {
  font-size: 34rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  margin-left: 16rpx;
  font-size: 27rpx;
}

.type-tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.type-tab {
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  color: #657068;
  font-size: 25rpx;
  background: #e8eee9;
}

.type-tab-active {
  color: #ffffff;
  background: #2f6f4e;
}

.favorites-content {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  padding: 4rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.state-text {
  padding: 180rpx 32rpx 0;
  color: #8a918b;
  font-size: 27rpx;
  text-align: center;
}

.favorite-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx 0;
  padding-bottom: 32rpx;
}

.card {
  width: calc(50% - 12rpx);
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(42, 65, 49, 0.08);
}

.card-image-wrap {
  position: relative;
  width: 100%;
  height: 220rpx;
}

.card-image,
.card-placeholder {
  width: 100%;
  height: 100%;
}

.card-image {
  display: block;
}

.card-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
  background: linear-gradient(145deg, #779b79, #b6c9a9);
}

.type-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  padding: 7rpx 14rpx;
  border-radius: 20rpx;
  color: #2f6f4e;
  font-size: 20rpx;
  line-height: 1;
  background: rgba(255, 255, 255, 0.9);
}

.card-content {
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
}

.card-title {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-meta {
  margin-top: 12rpx;
  overflow: hidden;
  color: #2f6f4e;
  font-size: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-description {
  width: 100%;
  max-height: 72rpx;
  margin-top: 12rpx;
  overflow: hidden;
  color: #666d67;
  font-size: 24rpx;
  line-height: 36rpx;
  overflow-wrap: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-tags {
  margin-top: 10rpx;
  overflow: hidden;
  color: #747b75;
  font-size: 23rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
