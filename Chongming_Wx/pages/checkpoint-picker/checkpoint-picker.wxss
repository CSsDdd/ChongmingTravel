page {
  height: 100%;
  overflow: hidden;
}

.picker-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.search-header {
  flex-shrink: 0;
  padding: 20rpx 24rpx 24rpx;
}

.picker-content {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.search-entry {
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  color: #747b75;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(42, 65, 49, 0.06);
}

.checkpoint-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx 0;
}

.empty-state {
  padding: 96rpx 24rpx;
  color: #747b75;
  font-size: 27rpx;
  text-align: center;
}

.checkpoint-card {
  width: calc(50% - 12rpx);
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(42, 65, 49, 0.08);
}

.card-content {
  display: flex;
  flex-direction: column;
  padding: 20rpx;
}

.checkpoint-title {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.checkpoint-location {
  margin-top: 14rpx;
  overflow: hidden;
  color: #2f6f4e;
  font-size: 25rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.checkpoint-tags {
  margin-top: 8rpx;
  overflow: hidden;
  color: #747b75;
  font-size: 23rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
