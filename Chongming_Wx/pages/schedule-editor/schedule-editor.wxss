.editor-page {
  height: 100vh;
  padding: 24rpx 24rpx 64rpx;
  background: #f5f7f4;
  box-sizing: border-box;
}

.loading-state {
  padding: 120rpx 0;
  color: #7b837c;
  font-size: 28rpx;
  text-align: center;
}

.form-section {
  margin-bottom: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.section-title {
  display: block;
  margin-bottom: 22rpx;
  color: #202520;
  font-size: 30rpx;
  font-weight: 700;
}

.select-field,
.setting-row,
.time-row {
  display: flex;
  align-items: center;
}

.select-field {
  justify-content: space-between;
  min-height: 108rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #f4f7f2;
}

.select-content,
.setting-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.select-value {
  overflow: hidden;
  color: #2b332d;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-arrow {
  margin-left: 20rpx;
  color: #66806d;
  font-size: 42rpx;
}

.field-label {
  color: #343c36;
  font-size: 27rpx;
  font-weight: 600;
}

.field-hint {
  margin-top: 8rpx;
  color: #8a918a;
  font-size: 22rpx;
}

.time-row + .time-row,
.setting-row + .setting-row {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf0ec;
}

.time-row > .field-label {
  width: 88rpx;
  flex: none;
}

.compact-field {
  min-width: 228rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  color: #354039;
  font-size: 26rpx;
  text-align: center;
  background: #f4f7f2;
}

.time-field {
  min-width: 140rpx;
  margin-left: 16rpx;
}

.setting-row {
  justify-content: space-between;
  min-height: 72rpx;
}

.setting-value {
  margin-left: 24rpx;
  color: #47775a;
  font-size: 25rpx;
  white-space: nowrap;
}

.setting-value-disabled {
  color: #a7ada8;
}

.note-input {
  width: 100%;
  height: 180rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  color: #303832;
  font-size: 26rpx;
  line-height: 1.5;
  background: #f4f7f2;
  box-sizing: border-box;
}

.save-button {
  width: 100%;
  margin: 12rpx 0 0;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  background: #2f6f4e;
}

.save-button::after {
  border: none;
}
