<scroll-view class="editor-page" scroll-y>
  <view wx:if="{{isLoading}}" class="loading-state">正在加载安排...</view>

  <block wx:else>
    <view class="form-section">
      <text class="section-title">安排目标</text>
      <picker
        disabled="{{mode === 'edit'}}"
        range="{{targetOptions}}"
        range-key="title"
        value="{{targetIndex}}"
        bindchange="onTargetChange"
      >
        <view class="select-field">
          <view class="select-content">
            <text class="select-value">{{selectedTargetTitle}}</text>
            <text class="field-hint">
              {{mode === 'edit' ? '已有安排暂不支持更换目标' : '当前阶段仅支持打卡点'}}
            </text>
          </view>
          <text wx:if="{{mode === 'create'}}" class="select-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-section">
      <text class="section-title">时间</text>
      <view class="time-row">
        <text class="field-label">开始</text>
        <picker mode="date" value="{{startDate}}" data-field="startDate" bindchange="onDateOrTimeChange">
          <view class="compact-field">{{startDate}}</view>
        </picker>
        <picker mode="time" value="{{startTime}}" data-field="startTime" bindchange="onDateOrTimeChange">
          <view class="compact-field time-field">{{startTime}}</view>
        </picker>
      </view>
      <view class="time-row">
        <text class="field-label">结束</text>
        <picker mode="date" value="{{endDate}}" data-field="endDate" bindchange="onDateOrTimeChange">
          <view class="compact-field">{{endDate}}</view>
        </picker>
        <picker mode="time" value="{{endTime}}" data-field="endTime" bindchange="onDateOrTimeChange">
          <view class="compact-field time-field">{{endTime}}</view>
        </picker>
      </view>
    </view>

    <view class="form-section">
      <text class="section-title">分享设置</text>
      <view class="setting-row">
        <view class="setting-copy">
          <text class="field-label">可见性</text>
          <text class="field-hint">公开安排之后可以用于寻找同行者</text>
        </view>
        <picker range="{{visibilityOptions}}" range-key="label" value="{{visibilityIndex}}" bindchange="onVisibilityChange">
          <view class="setting-value">{{visibilityOptions[visibilityIndex].label}} ›</view>
        </picker>
      </view>
      <view class="setting-row">
        <view class="setting-copy">
          <text class="field-label">同行招募</text>
          <text class="field-hint">私密、已完成或已取消时不可招募</text>
        </view>
        <picker
          disabled="{{visibility === 'PRIVATE' || planningStatus !== 'CONFIRMED'}}"
          range="{{recruitmentOptions}}"
          range-key="label"
          value="{{recruitmentIndex}}"
          bindchange="onRecruitmentChange"
        >
          <view class="setting-value {{visibility === 'PRIVATE' || planningStatus !== 'CONFIRMED' ? 'setting-value-disabled' : ''}}">
            {{recruitmentOptions[recruitmentIndex].label}} ›
          </view>
        </picker>
      </view>
      <view wx:if="{{mode === 'edit'}}" class="setting-row">
        <view class="setting-copy">
          <text class="field-label">安排状态</text>
          <text class="field-hint">用于标记安排已经完成或取消</text>
        </view>
        <picker range="{{planningOptions}}" range-key="label" value="{{planningIndex}}" bindchange="onPlanningChange">
          <view class="setting-value">{{planningOptions[planningIndex].label}} ›</view>
        </picker>
      </view>
    </view>

    <view class="form-section">
      <text class="section-title">共享备注</text>
      <textarea
        class="note-input"
        value="{{sharedNote}}"
        maxlength="300"
        placeholder="写下可以与同行者共享的信息"
        data-field="sharedNote"
        bindinput="onNoteInput"
      />
    </view>

    <view class="form-section">
      <text class="section-title">私人备注</text>
      <textarea
        class="note-input"
        value="{{privateNote}}"
        maxlength="300"
        placeholder="只有自己可以看到"
        data-field="privateNote"
        bindinput="onNoteInput"
      />
    </view>

    <button class="save-button" loading="{{isSaving}}" disabled="{{isSaving}}" bindtap="saveSchedule">
      {{mode === 'edit' ? '保存修改' : '创建安排'}}
    </button>
  </block>
</scroll-view>
