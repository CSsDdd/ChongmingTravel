.schedule-page {
  height: 100vh;
  padding: 0 24rpx 40rpx;
  background: #f5f7f4;
  box-sizing: border-box;
}

.schedule-section {
  margin-top: 24rpx;
  padding: 32rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.schedule-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.schedule-heading {
  color: #202520;
  font-size: 32rpx;
  font-weight: 700;
}

.schedule-count {
  color: #7b837c;
  font-size: 24rpx;
}

.schedule-card {
  display: flex;
  min-width: 0;
  flex-direction: column;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #e2f5d5;
}

.schedule-card-interested {
  background: #e2f1f8;
}

.schedule-card-interested .schedule-time {
  color: #356b88;
}

.schedule-card-completed {
  opacity: 0.62;
  background: #f1e2b38f;
}
.schedule-card-completed .schedule-time{
  color: #7a5912
}

.schedule-card-cancelled {
  opacity: 0.62;
  background: #f8d8d8c5;
}
.schedule-card-cancelled .schedule-time{
  color: #6e1212
}
.schedule-time {
  color: #47775a;
  font-size: 24rpx;
  font-weight: 600;
}

.schedule-title {
  margin-top: 10rpx;
  color: #202520;
  font-size: 30rpx;
  font-weight: 700;
}

.schedule-note {
  display: block;
  overflow: hidden;
  width: 100%;
  margin-top: 10rpx;
  color: #202520;
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-private-note {
  color: #8a7462;
}

.schedule-status {
  margin-top: 10rpx;
  color: #747c75;
  font-size: 24rpx;
}

.schedule-status-confirmed {
  color: #47775a;
}

.schedule-status-interested {
  color: #356b88;
}

.schedule-status-completed,
.schedule-status-cancelled {
  color: #8a918a;
}

.empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 72rpx 24rpx 56rpx;
}

.empty-title {
  color: #39413a;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-text {
  margin-top: 14rpx;
  color: #8a918a;
  font-size: 24rpx;
}

.login-button {
  margin-top: 32rpx;
  color: #ffffff;
  background: #2f6f4e;
}

.add-schedule-button {
  width: 100%;
  margin: 32rpx 0 0;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  background: #2f6f4e;
}

.add-schedule-button::after {
  border: none;
}
