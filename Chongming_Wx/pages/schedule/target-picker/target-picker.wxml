<view class="picker-page">
  <view class="picker-header">
    <input
      class="search-entry"
      value="{{query.text}}"
      bindinput="handleInput"
      placeholder="搜索安排目标"
    />
    <view class="type-filter">
      <view
        class="type-chip {{query.targetType === item.value ? 'type-chip-active' : ''}}"
        wx:for="{{typeOptions}}"
        wx:key="value"
        data-type="{{item.value}}"
        bindtap="selectTargetType"
      >{{item.label}}</view>
    </view>
  </view>

  <scroll-view class="picker-content" scroll-y>
    <view wx:if="{{isLoading}}" class="state-message">正在加载安排目标...</view>
    <view wx:elif="{{targets.length === 0}}" class="state-message">
      没有找到相关安排目标
    </view>

    <view wx:else class="target-list">
      <content-summary-card
        wx:for="{{targets}}"
        wx:key="viewKey"
        content="{{item}}"
        interactive="{{true}}"
        bind:select="selectTarget"
      />
    </view>
  </scroll-view>
</view>
