page {
  height: 100%;
  overflow: hidden;
  background: #f5f7f4;
}

.picker-page {
  display: flex;
  height: 100%;
  flex-direction: column;
  overflow: hidden;
}

.picker-header {
  flex: none;
  padding: 20rpx 24rpx 18rpx;
}

.search-entry {
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  color: #747b75;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(42, 65, 49, 0.06);
}

.type-filter {
  display: flex;
  margin-top: 18rpx;
  gap: 14rpx;
}

.type-chip {
  padding: 12rpx 28rpx;
  border: 2rpx solid #dbe4dc;
  border-radius: 30rpx;
  color: #657067;
  font-size: 24rpx;
  background: #ffffff;
}

.type-chip-active {
  border-color: #2f6f4e;
  color: #ffffff;
  background: #2f6f4e;
}

.picker-content {
  width: 100%;
  height: 0;
  min-height: 0;
  flex: 1;
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

.state-message {
  padding: 96rpx 24rpx;
  color: #747b75;
  font-size: 27rpx;
  text-align: center;
}

.target-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.target-card {
  display: flex;
  overflow: hidden;
  min-height: 190rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(42, 65, 49, 0.07);
}

.target-image,
.target-placeholder {
  width: 190rpx;
  height: 190rpx;
  flex: none;
}

.target-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.88);
  font-size: 23rpx;
  background: linear-gradient(145deg, #779b79, #b6c9a9);
}

.target-content {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  padding: 22rpx;
}

.target-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.target-title {
  overflow: hidden;
  min-width: 0;
  flex: 1;
  color: #252c27;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-badge {
  display: flex;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 17rpx;
  color: #2f6f4e;
  background: #eaf3ec;
  font-size: 19rpx;
  flex: none;
}

.source-badge-text {
  display: block;
  line-height: 1;
  transform: translateY(-1rpx);
}

.source-badge-draft {
  color: #8a6427;
  background: #f7efdf;
}

.target-meta,
.target-summary,
.target-tags {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.target-meta {
  margin-top: 10rpx;
  color: #2f6f4e;
  font-size: 22rpx;
}

.target-summary {
  margin-top: 10rpx;
  color: #687169;
  font-size: 23rpx;
}

.target-tags {
  margin-top: 8rpx;
  color: #929992;
  font-size: 21rpx;
}
