page {
  height: 100%;
  overflow: hidden;
  background: #f5f7f4;
}

.picker-page {
  display: flex;
  height: 100%;
  flex-direction: column;
  overflow: hidden;
}

.picker-header {
  flex: none;
  padding: 20rpx 24rpx 18rpx;
}

.search-entry {
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  color: #747b75;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(42, 65, 49, 0.06);
}

.type-filter {
  display: flex;
  margin-top: 18rpx;
  gap: 14rpx;
}

.type-chip {
  padding: 12rpx 28rpx;
  border: 2rpx solid #dbe4dc;
  border-radius: 30rpx;
  color: #657067;
  font-size: 24rpx;
  background: #ffffff;
}

.type-chip-active {
  border-color: #2f6f4e;
  color: #ffffff;
  background: #2f6f4e;
}

.picker-content {
  width: 100%;
  height: 0;
  min-height: 0;
  flex: 1;
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

.state-message {
  padding: 96rpx 24rpx;
  color: #747b75;
  font-size: 27rpx;
  text-align: center;
}

.target-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
