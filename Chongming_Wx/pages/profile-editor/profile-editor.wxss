.editor-page {
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f7f4;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  color: #858c85;
  font-size: 28rpx;
}

.form-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.field-label {
  display: block;
  color: #202520;
  font-size: 30rpx;
  font-weight: 700;
}

.field-hint {
  display: block;
  margin-top: 10rpx;
  color: #858c85;
  font-size: 24rpx;
}

.picker-value {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  color: #283128;
  font-size: 28rpx;
  background: #f2f5f1;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.selected-tag {
  color: #ffffff;
  background: #47775a;
}

.suggestion-title {
  margin-top: 22rpx;
}

.suggestion-tag {
  color: #356448;
  background: #e8f0e8;
}

.empty-text {
  color: #9aa09a;
  font-size: 26rpx;
}

.custom-tag-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.tag-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0rpx 22rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  background: #f2f5f1;
  font-size: 26rpx;
}

.tag-button {
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 64rpx;
  margin: 0 0 0 16rpx;
  padding: 0;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 64rpx;
  background: #47775a;
}

.bio-input {
  width: 100%;
  height: 240rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  background: #f2f5f1;
}

.character-count {
  display: block;
  margin-top: 10rpx;
  color: #929992;
  font-size: 22rpx;
  text-align: right;
}

.save-button {
  margin: 12rpx 0 48rpx;
  color: #ffffff;
  background: #2f6f4e;
}
