page {
  height: 100%;
  overflow: hidden;
}

.picker-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.search-header {
  flex-shrink: 0;
  padding: 20rpx 24rpx 24rpx;
}

.search-entry {
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  color: #747b75;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(42, 65, 49, 0.06);
}

.picker-content {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  padding: 0 24rpx 32rpx;
  box-sizing: border-box;
}

.empty-state {
  padding: 96rpx 24rpx;
  color: #747b75;
  font-size: 27rpx;
  text-align: center;
}

.route-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx 0;
}

.route-card {
  width: calc(50% - 12rpx);
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(42, 65, 49, 0.08);
}

.route-image,
.image-placeholder {
  width: 100%;
  height: 220rpx;
}

.route-image {
  display: block;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
  background: linear-gradient(145deg, #779b79, #b6c9a9);
}

.card-content {
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 20rpx;
}

.route-title {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.route-description {
  width: 100%;
  max-height: 68rpx;
  margin-top: 12rpx;
  overflow: hidden;
  color: #666d67;
  font-size: 23rpx;
  line-height: 34rpx;
  overflow-wrap: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.route-count {
  margin-top: 14rpx;
  color: #2f6f4e;
  font-size: 24rpx;
}

.route-tags {
  margin-top: 8rpx;
  overflow: hidden;
  color: #747b75;
  font-size: 22rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
