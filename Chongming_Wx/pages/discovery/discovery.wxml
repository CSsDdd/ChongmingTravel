<view class="discovery-page">
  <view class="search-header">
    <view class="search-entry" bindtap="openCheckpointSearch">
      <text class="search-icon">⌕</text>
      <text class="search-placeholder">搜索打卡点</text>
      <text class="search-arrow">›</text>
    </view>
  </view>

  <scroll-view class="discovery-content" scroll-y>
    <swiper class="banner" indicator-dots circular autoplay interval="4500">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="banner-card banner-tone-{{index}}">
          <text class="banner-title">{{item.title}}</text>
          <text class="banner-summary">{{item.summary}}</text>
        </view>
      </swiper-item>
    </swiper>

    <view class="section-heading">随机推荐</view>

    <view class="feed-list">
      <block wx:for="{{feedItems}}" wx:key="key">
        <view
          wx:if="{{item.type === 'CHECKPOINT'}}"
          class="card"
          data-id="{{item.data.checkpointId}}"
          data-version="{{item.data.version}}"
          bindtap="openCheckpoint"
        >
          <image
            wx:if="{{item.data.imageUrl}}"
            class="card-image"
            src="{{item.data.imageUrl}}"
            mode="aspectFill"
            data-index="{{index}}"
            binderror="onFeedImageError"
          />
          <view wx:else class="card-placeholder">户外探索</view>
          <view class="card-content">
            <text class="card-title">{{item.data.title}}</text>
            <text class="card-location">{{item.data.location.locationName}}</text>
            <text class="card-description">{{item.data.shortText}}</text>
            <text class="card-tags">{{item.data.tagText}}</text>
          </view>
        </view>

        <view
          wx:else
          class="card"
          data-id="{{item.data.routeId}}"
          data-version="{{item.data.version}}"
          bindtap="openRoute"
        >
          <image
            wx:if="{{item.data.imageUrl}}"
            class="card-image"
            src="{{item.data.imageUrl}}"
            mode="aspectFill"
            data-index="{{index}}"
            binderror="onFeedImageError"
          />
          <view wx:else class="card-placeholder">路线探索</view>
          <view class="card-content">
            <text class="card-title">{{item.data.title}}</text>
            <text class="card-description">{{item.data.description}}</text>
            <view class="route-meta">
              <text>{{item.data.tagText}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
