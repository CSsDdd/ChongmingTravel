@import "../favorites/favorites.wxss";

.profile-page {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  background: #f5f7f4;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background: #dfe7dc;
}

.user-summary {
  display: flex;
  flex-direction: column;
  margin-left: 28rpx;
}

.user-name {
  color: #202520;
  font-size: 36rpx;
  font-weight: 700;
}

.user-id {
  margin-top: 12rpx;
  color: #737a74;
  font-size: 24rpx;
}

.profile-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.card-pressed {
  opacity: 0.78;
}

.section-title {
  color: #202520;
  font-size: 32rpx;
  font-weight: 700;
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  border-bottom: 1rpx solid #edf0ec;
}

.profile-row:first-of-type {
  margin-top: 18rpx;
}

.profile-label {
  color: #565e57;
  font-size: 26rpx;
}

.profile-value {
  max-width: 470rpx;
  color: #202520;
  font-size: 28rpx;
  text-align: right;
}

.single-line {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bio-row {
  padding-top: 24rpx;
}

.bio-text {
  display: -webkit-box;
  height: 176rpx;
  margin-top: 12rpx;
  overflow: hidden;
  color: #202520;
  font-size: 28rpx;
  line-height: 44rpx;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}
