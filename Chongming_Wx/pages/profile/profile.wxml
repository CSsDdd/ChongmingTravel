<view class="profile-page">
  <view
    wx:if="{{currentUser}}"
    class="user-card"
    bindtap="onClickUserBasic"
    hover-class="card-pressed"
  >
    <image
      class="user-avatar"
      src="{{currentUser.avatarImageId}}"
      mode="aspectFill"
    />
    <view class="user-summary">
      <text class="user-name">{{currentUser.displayName}}</text>
      <text class="user-id">{{currentUser.id}}</text>
    </view>
  </view>

  <view
    wx:if="{{currentUser}}"
    class="profile-card"
    bindtap="onClickProfile"
    hover-class="card-pressed"
  >
    <text class="section-title">个人资料</text>

    <view class="profile-row">
      <text class="profile-label">年龄阶段</text>
      <text class="profile-value single-line">{{ageGroupLabel}}</text>
    </view>
    <view class="profile-row">
      <text class="profile-label">技能</text>
      <text class="profile-value single-line">{{skillText}}</text>
    </view>
    <view class="profile-row">
      <text class="profile-label">兴趣</text>
      <text class="profile-value single-line">{{interestText}}</text>
    </view>
    <view class="bio-row">
      <text class="profile-label">简介</text>
      <text class="bio-text">{{bioText}}</text>
    </view>
  </view>

  <view
    wx:if="{{currentUser}}"
    bindtap="onClickSchedule"
    hover-class="card-pressed"
  >
    <schedule-calendar />
  </view>

  <view wx:if="{{!currentUser && hasLoadedCurrentUser}}" class="placeholder">
    <text class="placeholder-title">尚未登录</text>
    <text class="placeholder-text">登录后可以查看和编辑个人资料。</text>
    <button class="login-button" bindtap="goToLogin">登录演示账号</button>
  </view>
</view>
