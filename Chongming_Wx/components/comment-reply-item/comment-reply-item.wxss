:host {
  display: block;
}

.reply-item {
  padding: 22rpx 0;
  border-top: 1rpx solid #e3e8e3;
}

.reply-header {
  display: flex;
  min-width: 0;
  align-items: center;
}

.reply-avatar {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 auto;
  border-radius: 50%;
}

.reply-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #829888;
  font-size: 22rpx;
  font-weight: 600;
}

.reply-identity {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
  margin-left: 14rpx;
}

.reply-author {
  overflow: hidden;
  color: #344139;
  font-size: 24rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reply-time {
  color: #9aa19c;
  font-size: 19rpx;
  white-space: nowrap;
}

.reply-actions {
  display: flex;
  width: auto;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
  margin-left: 12rpx;
}

.reply-action {
  display: flex;
  width: auto;
  height: 46rpx;
  flex: 0 0 auto;
  align-items: center;
  gap: 4rpx;
  padding: 0 6rpx;
  color: #69766e;
  font-size: 19rpx;
  line-height: 1;
}

.reply-action-icon {
  width: 26rpx;
  height: 26rpx;
}

.reply-action-liked {
  color: #d84a4a;
}

.reply-deleted-placeholder {
  margin-left: 68rpx;
  padding: 10rpx 0;
  color: #a0a7a2;
  font-size: 23rpx;
  line-height: 34rpx;
}

.reply-body {
  position: relative;
  margin-top: 14rpx;
  margin-left: 68rpx;
}

.reply-text {
  display: -webkit-box;
  overflow: hidden;
  color: #4a544e;
  font-size: 25rpx;
  line-height: 39rpx;
  overflow-wrap: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
}

.reply-text-expanded {
  display: block;
  overflow: visible;
}

.reply-text-measure {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  display: block;
  visibility: hidden;
  pointer-events: none;
}

.reply-expand {
  margin-top: 8rpx;
  color: #3d7655;
  font-size: 21rpx;
  line-height: 32rpx;
}

.reply-reference {
  display: flex;
  min-width: 0;
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 10rpx;
  color: #7e8781;
  background: #e9ece9;
  font-size: 21rpx;
  line-height: 30rpx;
}

.reply-reference-author {
  flex: 0 0 auto;
}

.reply-reference-content {
  overflow: hidden;
  min-width: 0;
  flex: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}
