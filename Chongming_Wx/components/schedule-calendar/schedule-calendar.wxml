<view class="calendar-card">
  <view class="calendar-header">
    <text class="calendar-heading">安排日历</text>
    <text class="calendar-month">{{title}}</text>
  </view>

  <view class="weekday-row">
    <text
      wx:for="{{weekdayLabels}}"
      wx:key="*this"
      class="weekday-label"
    >{{item}}</text>
  </view>

  <view class="calendar-grid">
    <view
      wx:for="{{cells}}"
      wx:key="key"
      class="calendar-cell"
    >
      <text
        wx:if="{{item.inMonth}}"
        class="day-number {{item.isToday ? 'today' : ''}}"
      >{{item.day}}</text>
    </view>
  </view>
</view>
