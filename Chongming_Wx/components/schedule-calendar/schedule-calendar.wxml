<view class="calendar-card">
  <view class="calendar-header">
    <text class="calendar-heading">安排日历</text>
    <view class="month-controls">
      <view
        wx:if="{{interactive}}"
        class="month-button"
        bindtap="onPreviousMonth"
        hover-class="month-button-pressed"
      >‹</view>
      <text class="calendar-month">{{title}}</text>
      <view
        wx:if="{{interactive}}"
        class="month-button"
        bindtap="onNextMonth"
        hover-class="month-button-pressed"
      >›</view>
    </view>
  </view>

  <view class="weekday-row">
    <text
      wx:for="{{weekdayLabels}}"
      wx:key="*this"
      class="weekday-label"
    >{{item}}</text>
  </view>

  <view class="calendar-grid">
    <view
      wx:for="{{cells}}"
      wx:key="key"
      class="calendar-cell"
      data-date="{{item.date}}"
      bindtap="onDayTap"
    >
      <text
        class="day-number {{!item.inMonth ? 'outside-month' : ''}} {{item.hasInterested ? 'interested-day' : ''}} {{interactive && item.isSelected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
      >{{item.day}}</text>
      <view
        wx:if="{{item.hasConfirmed}}"
        class="date-indicator"
      ></view>
    </view>
  </view>
</view>
