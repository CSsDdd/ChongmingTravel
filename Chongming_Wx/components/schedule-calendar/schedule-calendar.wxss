:host {
  display: block;
}

.calendar-card {
  margin-top: 24rpx;
  padding: 32rpx 24rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 8rpx 24rpx;
}

.calendar-heading {
  flex: 0 0 auto;
  color: #202520;
  font-size: 32rpx;
  font-weight: 700;
  white-space: nowrap;
}

.month-controls {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  width: auto;
  margin-left: auto;
}

.month-button {
  display: flex;
  flex: 0 0 36rpx;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 52rpx;
  color: #47775a;
  font-size: 38rpx;
}

.month-button-pressed {
  opacity: 0.55;
}

.calendar-month {
  flex: 0 0 auto;
  min-width: 120rpx;
  margin: 0 8rpx;
  color: #687068;
  font-size: 22rpx;
  text-align: center;
  white-space: nowrap;
}

.weekday-row,
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.weekday-label,
.calendar-cell {
  width: 14.2857%;
  text-align: center;
}

.weekday-label {
  padding-bottom: 16rpx;
  color: #8a918a;
  font-size: 24rpx;
}

.calendar-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
}

.day-number {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  color: #303730;
  font-size: 26rpx;
  line-height: 52rpx;
  text-align: center;
}

.selected {
  color: #315c42;
  font-weight: 700;
  background: #dfeadf;
}

.today {
  color: #ffffff;
  font-weight: 700;
  background: #47775a;
}
