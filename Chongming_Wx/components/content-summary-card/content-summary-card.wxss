:host {
  display: block;
}

.summary-card {
  display: flex;
  overflow: hidden;
  min-height: 190rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(42, 65, 49, 0.07);
}

.summary-card-hover {
  opacity: 0.72;
}

.summary-image,
.summary-placeholder {
  width: 190rpx;
  height: 190rpx;
  flex: none;
}

.summary-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.88);
  font-size: 23rpx;
  background: linear-gradient(145deg, #779b79, #b6c9a9);
}

.summary-content {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  padding: 22rpx;
}

.summary-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.summary-title {
  overflow: hidden;
  min-width: 0;
  flex: 1;
  color: #252c27;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-badge {
  display: flex;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 17rpx;
  color: #2f6f4e;
  background: #eaf3ec;
  font-size: 19rpx;
  flex: none;
}

.source-badge-text {
  display: block;
  line-height: 1;
  transform: translateY(-1rpx);
}

.source-badge-draft {
  color: #8a6427;
  background: #f7efdf;
}

.summary-meta,
.summary-description,
.summary-tags {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-meta {
  margin-top: 10rpx;
  color: #2f6f4e;
  font-size: 22rpx;
}

.summary-description {
  margin-top: 10rpx;
  color: #687169;
  font-size: 23rpx;
}

.summary-tags {
  margin-top: 8rpx;
  color: #929992;
  font-size: 21rpx;
}
